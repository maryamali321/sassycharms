# Copy this file to .env.local and fill in your own values.

# --- MongoDB (products, coupons, orders) ---
# Get a free connection string from https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/saasycharms

# --- Cloudinary (product image hosting) ---
# Get these from https://cloudinary.com/console after creating a free account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin panel login ---
# The single password used to log into /admin. Keep this secret.
ADMIN_PASSWORD=

# --- WhatsApp checkout ---
# Full international number, digits only, no + or spaces (e.g. 923001234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000

# --- SEO ---
# Your live site URL (used for canonical links, sitemap, and Open Graph tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
